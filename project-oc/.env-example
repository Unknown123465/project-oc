# 환경 변수 예시 목록


# 데이터베이스
DATABASE_URL = "mysql://username:password@url:port/dbname"
DATABASE_HOST = "127.0.0.1"
DATABASE_PORT = "3306"
DATABASE_USER = "root"
DATABASE_NAME = "dbname"
DATABASE_PASSWORD = "password"
# 운영 DB의 CA 인증서 내용 전체(-----BEGIN CERTIFICATE----- 부터 끝까지, 줄바꿈 포함)
# 넣으면 TLS로 연결하고 서버 인증서를 이 CA로 검증한다. 로컬 MySQL처럼 TLS가 없으면 비워 둔다
DATABASE_CA_CERT = ""

# 테스트 데이터베이스 전용
# 같은 서버에 이 이름으로 데이터베이스를 따로 만들고 스키마를 넣어 둘 것
# 테스트가 행을 심고 지우므로 DATABASE_NAME과 같은 값을 넣으면 개발 DB가 지워짐
DATABASE_TEST_NAME = "dbname_test"

# auth 시크릿키
AUTH_SECRET = secret

# 구글 계정 연동
GOOGLE_CLIENT_ID = google-client-id
GOOGLE_CLIENT_SECRET = google-client-secret

# 네이버 계정 연동
NAVER_CLIENT_ID = naver-client-id
NAVER_CLIENT_SECRET = naver-client-secret

# 카카오 계정 연동
KAKAO_CLIENT_ID = kakao-client-id
KAKAO_CLIENT_SECRET = kakao-client-secret

# Kakao SDK for JavaScript 연동 JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY = 

# X(트위터) 계정 연동
TWITTER_CLIENT_ID = twitter-client-id
TWITTER_CLIENT_SECRET = twitter-client-secret

# cloudflare R2 api 연동
R2_ACCOUNT_ID = account-id
R2_ACCESS_KEY_ID = access-key-id
R2_SECRET_ACCESS_KEY = secret-access-key
R2_PUBLIC_BUCKET = public-bucket
R2_PRIVATE_BUCKET = private-bucket
R2_PUBLIC_URL = public-url

# 배포 주소 og:image 등 절대 URL이 필요한 metadata에 사용
NEXT_PUBLIC_SITE_URL = https://example.com

# google ai api key
GOOGLE_AI_API_KEY = google-api-key

# Jev에 쓰일 TypeSafe api key
TYPESAFE_API_KEY = typesafe-api-key
z
# Jev를 통해 코멘트를 블라인드 하거나 거부할 판정 수치 값
BLIND_COMMENT_SCORE = 75
DENY_COMMENT_SCORE = 90

#삭제된 코멘트가 몇일 후 DB에서 삭제되는지 결정하는 값
DELETE_COMMENT_AFTER_DAYS = 30

# Vercel Global Config 연결 문자열
VERCEL_CONFIG_STORE_URL = https://global-config.vercel.com/...

# Vercel 크론 시크릿 키
CRON_SECRET = ...

# 비밀번호 변경/재설정 및 이메일 주소 변경 등 메일을 보내는 Resend API 키와 보내는 주소
RESEND_API_KEY = resend-api-key
MAIL_FROM_ADDRESS = noreply@example.com

# aiHistory 테이블의 이메일/provider ID를 해시할 때 쓰이는 시크릿값
AI_HISTORY_HASH_SECRET = secret