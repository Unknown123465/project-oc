# 환경 변수 예시 목록


# 데이터베이스
DATABASE_URL = "mysql://username:password@url:port/dbname"
DATABASE_HOST = "127.0.0.1"
DATABASE_USER = "root"
DATABASE_NAME = "dbname"
DATABASE_PASSWORD = "password"

# auth 시크릿키
BETTER_AUTH_SECRET = secret

# 구글 계정 연동
GOOGLE_CLIENT_ID = google-client-id
GOOGLE_CLIENT_SECRET = google-client-secret

# 네이버 계정 연동
NAVER_CLIENT_ID = naver-client-id
NAVER_CLIENT_SECRET = naver-client-secret

# 카카오 계정 연동
KAKAO_CLIENT_ID = kakao-client-id
KAKAO_CLIENT_SECRET = kakao-client-secret

# X(트위터) 계정 연동
TWITTER_CLIENT_ID = twitter-client-id
TWITTER_CLIENT_SECRET = twitter-client-secret

# cloudflare R2 api 연동
R2_ACCOUNT_ID = account-id
R2_ACCESS_KEY_ID = access-key-id
R2_SECRET_ACCESS_KEY = secret-access-key
R2_PUBLIC_BUCKET = public-bucket
R2_PRIVATE_BUCKET = private-bucket
R2_PUBLIC_URL = public-url

# 배포 주소 og:image 등 절대 URL이 필요한 metadata에 사용
NEXT_PUBLIC_SITE_URL = https://example.com

# google ai api key
GOOGLE_AI_API_KEY = google-api-key

# Vercel Global Config 연결 문자열
VERCEL_CONFIG_STORE_URL = https://global-config.vercel.com/...